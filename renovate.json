{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "mergeConfidence:all-badges",
    "config:recommended",
    "group:all"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^charts/.*\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^charts/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "targetRevision:\\s*(?<currentDigest>[0-9a-f]{40})\\s+# renovate: datasource=git-refs depName=(?<depName>[^\\s]+) packageName=(?<packageName>[^\\s]+) currentValue=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git",
      "autoReplaceStringTemplate": "targetRevision: {{{newDigest}}} # renovate: datasource=git-refs depName={{{depName}}} packageName={{{packageName}}} currentValue={{{currentValue}}}"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "/^charts\\/.+\\.ya?ml$/"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
